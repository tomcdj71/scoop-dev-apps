{
    "version": "1.99.0",
    "description": "A language empowering everyone to build reliable and efficient software. (MSVC toolchain)",
    "homepage": "https://www.rust-lang.org",
    "license": "MIT|Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://static.rust-lang.org/dist/rust-1.99.0-x86_64-pc-windows-msvc.msi",
            "hash": "0ccecc0d77722cf4ab3288ecdcf541530bec129b530f91618cbdd9e3a0dbe7fd"
        },
        "32bit": {
            "url": "https://static.rust-lang.org/dist/rust-1.99.0-i686-pc-windows-msvc.msi",
            "hash": "219bba7c267d4e1b39166063205ef590fc3ff6ea1ff4a7c4ce01b56db3c4d3bd"
        }
    },
    "extract_dir": "Rust",
    "bin": [
        "bin\\rls.exe",
        "bin\\rustc.exe",
        "bin\\rustdoc.exe",
        "bin\\cargo.exe"
    ],
    "checkver": {
        "url": "https://www.rust-lang.org/",
        "regex": "Version ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.rust-lang.org/dist/rust-$version-x86_64-pc-windows-msvc.msi"
            },
            "32bit": {
                "url": "https://static.rust-lang.org/dist/rust-$version-i686-pc-windows-msvc.msi"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
